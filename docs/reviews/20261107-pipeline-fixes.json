  "findings": [
    {
      "id": "F01",
      "priority": "P1",
      "status": "fixed",
      "original_title": "A completed phase can restart Bonsai during a newer GPU phase",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/ops/run54_gpu_phase.py#L36-L42",
      "implementation": [
        "ops/run54_gpu_phase.py"
      ],
      "resolution": "All checkouts share a host lock and durable owner lease. Cleanup is idempotent and cannot restore an older owner inside a newer GPU window. Abandoned leases recover under the lock; initially inactive services stay inactive. A bounded post-stop readiness wait retains strict GPU admission and recovery uses only the standard library.",
      "regression_tests": [
        "test_gpu_supervisor.RestorationTests",
        "test_pipeline_contracts.PipelineContracts.test_f01_old_restore_cannot_restart_a_new_owners_gpu_window"
      ]
    },
    {
      "id": "F02",
      "priority": "P1",
      "status": "fixed",
      "original_title": "Omitting the adapter hash bypasses the training-to-evaluation binding",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/scripts/compare_coder.py#L86-L88",
      "implementation": [
        "scripts/compare_coder.py"
      ],
      "resolution": "Every candidate requires valid weight, configuration and training-result identities. Complete acceptance also requires attestations for actual client requests. Missing/legacy/mismatched evidence fails before a quality verdict.",
      "regression_tests": [
        "test_pipeline_contracts.PipelineContracts.test_f02_missing_weight_identity_fails_closed",
        "test_pipeline_contracts.PipelineContracts.test_f02_wrong_configuration_cannot_borrow_validation_loss",
        "test_pipeline_contracts.PipelineContracts.test_f02_client_proof_is_required_and_bound_to_the_candidate"
      ]
    },
    {
      "id": "F03",
      "priority": "P2",
      "status": "fixed",
      "original_title": "The exporter requires a source archive that training never writes",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/scripts/select_coder_checkpoint.py#L75-L79",
      "implementation": [
        "scripts/coder_artifacts.py",
        "scripts/train_coder.py",
        "scripts/select_coder_checkpoint.py"
      ],
      "resolution": "Training captures and authenticates its recipe/configuration. Selection verifies that archive, preserves the parent source, stores selection source separately and atomically publishes a complete export. Failures remove only staging, allowing retry.",
      "regression_tests": [
        "test_artifact_flow.ArtifactFlowTests.test_frozen_recipe_detects_missing_and_changed_files",
        "test_artifact_flow.ArtifactFlowTests.test_selected_checkpoint_compiles_and_preserves_parent_recipe",
        "test_artifact_flow.ArtifactFlowTests.test_failed_export_leaves_no_destination_and_can_be_retried"
      ]
    },
    {
      "id": "F04",
      "priority": "P2",
      "status": "fixed",
      "original_title": "Tool-call markup inside ordinary Python code is interpreted as a real call",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/scripts/coder_common.py#L344-L348",
      "implementation": [
        "scripts/coder_common.py"
      ],
      "resolution": "Fenced examples and valid Python are literal output. Native function blocks are recognized at top-level call boundaries, with strict argument validation and malformed-call rejection preserved.",
      "regression_tests": [
        "test_pipeline_contracts.PipelineContracts.test_f04_fenced_code_and_unfenced_python_strings_are_literal",
        "test_pipeline_contracts.PipelineContracts.test_f04_real_call_after_code_fence_and_adjacent_calls_survive"
      ]
    },
    {
      "id": "F05",
      "priority": "P2",
      "status": "fixed",
      "original_title": "The HF serving identity omits behavior-changing adapter configuration and limits",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/scripts/serve_coder.py#L94-L100",
      "implementation": [
        "scripts/serve_coder.py",
        "ops/run54_gguf_phase.py"
      ],
      "resolution": "Schema-2 profile identity binds input proof, effective limits, adapter weights/configuration and training-result fingerprint. A separate per-process nonce binds individual JSON/SSE requests without preventing paired runs across processes.",
      "regression_tests": [
        "test_pipeline_contracts.ServingIdentityContracts.test_f05_adapter_scaling_and_effective_limits_change_identity",
        "test_pipeline_contracts.PipelineContracts.test_f05_malformed_profile_hash_and_limits_cannot_be_paired"
      ]
    },
    {
      "id": "F06",
      "priority": "P2",
      "status": "fixed",
      "original_title": "A proof can omit the model weights and still pass verification",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/scripts/coder_common.py#L200-L207",
      "implementation": [
        "scripts/coder_common.py"
      ],
      "resolution": "The authenticated index must name exactly the proof\u2019s weight shards. Every loader file present in the snapshot must be authenticated. Changed or omitted weights/sidecars are rejected.",
      "regression_tests": [
        "test_pipeline_contracts.PipelineContracts.test_f06_all_index_shards_must_be_authenticated",
        "test_coder.ProtocolTests.test_snapshot_proof_rejects_changed_inputs_and_wrong_identity"
      ]
    },
    {
      "id": "F07",
      "priority": "P2",
      "status": "fixed",
      "original_title": "Tool argument strings bypass chat-control-token validation",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/scripts/coder_common.py#L274-L278",
      "implementation": [
        "scripts/coder_common.py"
      ],
      "resolution": "Nested tool arguments and tool descriptions/schemas receive the same delimiter and credential-pattern validation as message content before native-template rendering.",
      "regression_tests": [
        "test_pipeline_contracts.PipelineContracts.test_f07_nested_arguments_and_tool_descriptions_cannot_inject_roles",
        "test_coder.ProtocolTests.test_mask_excludes_system_user_and_tool_tokens"
      ]
    },
    {
      "id": "F08",
      "priority": "P2",
      "status": "fixed",
      "original_title": "Client results are labeled with one initial health identity, not the actual requests",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/ops/smoke_clients.py#L138-L140",
      "implementation": [
        "ops/client_proxy.py",
        "ops/smoke_clients.py",
        "ops/project_clients.py"
      ],
      "resolution": "Both installed-client harnesses use a loopback proxy that validates every completion response/chunk against the expected model and server instance, requires actual completion traffic and records an attestation. Unsupported capability probes return 404 and never count as completions.",
      "regression_tests": [
        "test_client_proxy.ClientProxyTests",
        "test_pipeline_contracts.PipelineContracts.test_f02_client_proof_is_required_and_bound_to_the_candidate"
      ]
    },
    {
      "id": "F09",
      "priority": "P2",
      "status": "fixed",
      "original_title": "The published native workflow has no producer for its required conversion manifest",
      "original_source_url": "https://github.com/groxaxo/weight-space-programming/blob/d2a92cf3b5fbc4ea4debdfa7a488cf5136a1893e/ops/run54_gguf_phase.py#L119-L122",
      "implementation": [
        "scripts/convert_coder_gguf.py"
      ],
      "resolution": "The committed producer authenticates inputs, runs CPU Q8 conversion, creates compiled or unmerged manifests, supports authenticated base reuse and publishes atomically. Its output is consumed by the native supervisor without hand-authored fields.",
      "regression_tests": [
        "test_artifact_flow.ArtifactFlowTests.test_conversion_manifest_is_consumable_and_tampering_fails_closed",
        "test_artifact_flow.ArtifactFlowTests.test_compiled_manifest_binds_provenance_and_failed_conversion_is_retryable"
      ]
    }
